tool_name="hdconfigure_webapps_static_internal_create_template_page"

github_username="$1"
github_repo_name="$2"
applet_name="$3"
applet_page="$4"

webapp_parent_directory="$HOME/.config/hdconfigure/webapps/static/$github_username"
webapp_directory="$webapp_parent_directory/$github_repo_name"

index_ts=$(cat << 'EOF'
/*
  Copyright (C) 2026 by Theron Kauk and John Morris Beck <hdconfigure.direct@gmail.com> 
  THE SOFTWARE IS PROVIDED "AS IS" AND THE AUTHOR DISCLAIMS ALL WARRANTIES WITH REGARD TO THIS SOFTWARE 
  INCLUDING ALL IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE 
  FOR ANY SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES WHATSOEVER RESULTING FROM LOSS 
  OF USE, DATA OR PROFITS, WHETHER IN AN ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING 
  OUT OF OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
*/
import path from 'path';
import os from 'os';
import { pathToFileURL } from 'url';
(async () => {
    const configPath = path.join(
	os.homedir(),
	'.config',
	'hdconfigure',
	'tools',
	'git',
	'hdconfigure',
	'hdconfigure_webapps',
	'hdconfigure_webapps_build_page.ts'
    );
    const configUrl = pathToFileURL(configPath).href;
    const hdui = await import(configUrl);
    const result = hdui.generate_html_page(












	"/style.css",
	"TruckAds",
	"./menu/",
	"Truck Ads",
	"by HD Configure",






	hdui.subheader("This is a subheader") +
	    hdui.image("https://upload.wikimedia.org/wikipedia/commons/a/a6/Pink_lady_and_cross_section.jpg?utm_source=en.wikipedia.org&utm_campaign=index&utm_content=original") +
	    hdui.text(
		"This is some text") +
	    hdui.button("https://www.google.com", "This is a button") 
    );














    console.log(result);
})().catch(console.error);
EOF
)

if [ "$applet_name" = "home" ]; then
    mkdir "$webapp_directory/$applet_page" || { error "error: $tool_name failed to create applet page directory $webapp_directory/$applet_page. Applet page already exists.\n"; exit 1; }
    print "$index_ts" > "$webapp_directory/$applet_page/index.ts" || { error "error: $tool_name failed to create index.ts file in $webapp_directory/$applet_page.\n"; exit 1; }
else
    if [ "$applet_page" = "home" ]; then
        mkdir "$webapp_directory/$applet_name" || { error "error: $tool_name failed to create applet directory $webapp_directory/$applet_name. Applet already exists.\n"; exit 1; }
        print "$index_ts" > "$webapp_directory/$applet_name/index.ts" || { error "error: $tool_name failed to create index.ts file in $webapp_directory/$applet_name.\n"; exit 1; }
    else
        mkdir "$webapp_directory/$applet_name/$applet_page" || { error "error: $tool_name failed to create applet directory $webapp_directory/$applet_name/$applet_page. Applet already exists.\n"; exit 1; }
        print "$index_ts" > "$webapp_directory/$applet_name/$applet_page/index.ts" || { error "error: $tool_name failed to create index.ts file in $webapp_directory/$applet_name/$applet_page.\n"; exit 1; }
    fi
fi
