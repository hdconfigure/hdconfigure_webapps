tool_name="hdconfigure_webapps_static_create_applet"

if [ "$#" -lt 4 ]; then
    error "error: $tool_name usage: $tool_name <github_username> <github_repo_name> <applet_name> <applet_page>\n"
    exit 1
fi

github_username="$1"
github_repo_name="$2"
applet_name="$3"
applet_page="$4"

webapp_parent_directory="$HOME/.config/hdconfigure/webapps/static/$github_username"
webapp_directory="$webapp_parent_directory/$github_repo_name"

if [ ! -d "$webapp_directory" ]; then
    error "error: $tool_name webapp directory $webapp_directory does not exist.\n"
    exit 1
fi

index_ts=$(cat << 'EOF'
sample_file
EOF
)

menu_ts=$(cat << 'EOF'
sample_menu
EOF
)

create_applet() {
    mkdir "$webapp_directory/$1" || { error "error: $tool_name failed to create applet $1.\n"; exit 1; }
}

if [ "$applet_name" = "home" ]; then
    create_applet "$applet_name"
    print "$index_ts" > "$webapp_directory/$applet_name/index.ts" || { error "error: $tool_name failed to create index.ts file in $webapp_directory/$applet_name.\n"; exit 1; }
    if [ "$applet_page" = "home" ]; then
        create_applet "$applet_name/menu"
        print "$menu_ts" > "$webapp_directory/$applet_name/menu/menu.ts" || { error "error: $tool_name failed to create menu.ts file in $webapp_directory/$applet_name/menu.\n"; exit 1; }
    else
        create_applet "$applet_name/$applet_page"
        print "$menu_ts" > "$webapp_directory/$applet_name/$applet_page/menu.ts" || { error "error: $tool_name failed to create menu.ts file in $webapp_directory/$applet_name/$applet_page.\n"; exit 1; }
    fi
else
    create_applet "$applet_name"
    if [ "$applet_page" = "home" ]; then
        print "$index_ts" > "$webapp_directory/$applet_name/index.ts" || { error "error: $tool_name failed to create index.ts file in $webapp_directory/$applet_name.\n"; exit 1; }
        create_applet "$applet_name/menu"
        print "$menu_ts" > "$webapp_directory/$applet_name/menu/menu.ts" || { error "error: $tool_name failed to create menu.ts file in $webapp_directory/$applet_name/menu.\n"; exit 1; }
    else
        create_applet "$applet_name/$applet_page"
        print "$menu_ts" > "$webapp_directory/$applet_name/$applet_page/menu.ts" || { error "error: $tool_name failed to create menu.ts file in $webapp_directory/$applet_name/$applet_page.\n"; exit 1; }
    fi
fi
