tool_name="hdconfigure_webapps_static_create_applet"

if [ "$#" -lt 4 ]; then
    error "error: $tool_name usage: $tool_name <github_username> <github_repo_name> <applet_name> <applet_page>\n"
    exit 1
fi

github_username="$1"
github_repo_name="$2"
applet_name="$3"
applet_page="$4"

webapp_parent_directory="$HOME/.config/hdconfigure/webapps/static/$github_username"
webapp_directory="$webapp_parent_directory/$github_repo_name"

if [ ! -d "$webapp_directory" ]; then
    error "error: $tool_name webapp directory $webapp_directory does not exist.\n"
    exit 1
fi

index=$(cat << 'EOF'
//Copyright (C) 2026 by Theron Kauk and John Morris Beck <hd.configure.direct@gmail.com> THE SOFTWARE IS PROVIDED "AS IS" AND THE AUTHOR DISCLAIMS ALL WARRANTIE WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF MERCHANTABILIT AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR ANY SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
import path from 'path';
import os from 'os';
import { pathToFileURL } from 'url';
(async () => {
    const configPath = path.join(
	os.homedir(),
	'.config',
	'hdconfigure',
	'tools',
	'git',
	'hdconfigure',
	'hdconfigure_webapps',
	'hdconfigure_webapps_build_page.ts'
    );
    const configUrl = pathToFileURL(configPath).href;
    const hdui = await import(configUrl);
    const result = hdui.generate_html_page(












	     "/style.css",
        "Example",
        "./menu/",
        "header",
        "small script",







	hdui.subheader("This is a subheader!") +
	    hdui.image("https://en.wikipedia.org/wiki/Apple#/media/File:Pink_lady_and_cross_section.jpg") +
	    hdui.text(
		"This is some text") +
	    hdui.button("https://www.google.com/", "This is a buton")

    );














    console.log(result);
})().catch(console.error);
EOF
)

menu=$(cat << 'EOF'
//Copyright (C) 2026 by Theron Kauk and John Morris Beck <hd.configure.direct@gmail.com> THE SOFTWARE IS PROVIDED "AS IS" AND THE AUTHOR DISCLAIMS ALL WARRANTIE WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF MERCHANTABILIT AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR ANY SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
import path from 'path';
import os from 'os';
import { pathToFileURL } from 'url';
(async () => {
    const configPath = path.join(
	os.homedir(),
	'.config',
	'hdconfigure',
	'tools',
	'git',
	'hdconfigure',
	'hdconfigure_webapps',
	'hdconfigure_webapps_build_page.ts'
    );
    const configUrl = pathToFileURL(configPath).href;
    const hdui = await import(configUrl);
    const result = hdui.generate_html_page(












	     "/style.css",
        "Example",
        "./menu/",
        "header",
        "small script",







	hdui.subheader("This is a subheader!") +
	    hdui.image("https://en.wikipedia.org/wiki/Apple#/media/File:Pink_lady_and_cross_section.jpg") +
	    hdui.text(
		"This is some text") +
	    hdui.button("https://www.google.com/", "This is a buton")

    );














    console.log(result);
})().catch(console.error);
EOF
)

create_applet() {
    mkdir "$webapp_directory/$1" || { error "error: $tool_name failed to create applet $webapp_directory/$1.
"; exit 1; }

}
create_file(){
    print "$3" > "$webapp_directory/$1/$2" || { error "error: $tool_name failed to create file $webapp_directory/$1.
"; exit 1; }
    }


handle_home_applet() {
    if [ "$applet_page" = "home" ]; then
	create_applet "menu_applet"
        create_file "menu_applet" "index.ts" "$menu"
    fi
    create_applet "$applet_page"
    create_file "$applet_page" "index.ts" "$index"
    if [ "$applet_page" != "home" ]; then
       touch "$webapp_directory/$applet_page/home_applet"
    fi;
}

handle_regular_applet() {
    if [ -f "$webapp_directory/$applet_name/home_applet" ]; then
	"error: $tool_name failed to create "$webapp_directory/$applet_name" already exists and is a home applet";
	exit 1;
    fi
    if [ "$applet_page" = "home" ]; then
	create_applet "$applet_name"
	create_applet "$applet_name/menu_applet"
        create_file "$applet_name/menu_applet" "index.ts" "$menu"
	create_file "$applet_name" "index.ts" "$index"
    else
        create_applet "$applet_name/$applet_page"
	create_file "$applet_name/$applet_page" "index.ts" "$index"
    fi
}

if [ "$applet_name" = "home" ]; then
    handle_home_applet
else
    handle_regular_applet
fi
