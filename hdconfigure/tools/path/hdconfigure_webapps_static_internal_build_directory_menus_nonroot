tool_name="hdconfigure_webapps_static_internal_build_directory_menus_nonroot"

fail() {
    error "error: $tool_name $1
"
    exit 1
}

validate_argument_count() {
    if [ "$1" -lt 2 ]; then
        fail "usage: $tool_name <github_username> <github_repo_name>"
    fi
}

validate_webapp_directory() {
    if [ ! -d "$webapp_directory" ]; then
        fail "webapp directory $webapp_directory does not exist."
    fi
}

is_nonroot_applet_directory() {
    [ -d "$1" ] && [ -f "$1/index.ts" ] && [ ! -f "$1/home_applet" ]
}

is_updatable_subpage_directory() {
    dir_name="$(basename "$1")"
    [ -d "$1" ] && [ -f "$1/index.ts" ] && [ "$dir_name" != "menu" ] && [ "$dir_name" != "menu_applet" ]
}

validate_menu_source() {
    if [ ! -f "$1/menu_applet/index.ts" ]; then
        fail "menu_applet exists in $1, but $1/menu_applet/index.ts does not exist."
    fi
}

ensure_directory_exists() {
    mkdir -p "$1" || fail "failed to create directory $1."
}

copy_menu_file() {
    cp "$1" "$2" || fail "failed to copy $1 to $2."
}

install_menu_into_directory() {
    ensure_directory_exists "$2"
    copy_menu_file "$1" "$2/index.ts"
}

sync_subpage_if_eligible() {
    current_subapplet_page="$2"
    if is_updatable_subpage_directory "$current_subapplet_page"; then
        install_menu_into_directory "$1" "$current_subapplet_page/menu"
    fi
}

distribute_menu_to_subpages() {
    for candidate_dir in "$1"/*; do
        sync_subpage_if_eligible "$2" "$candidate_dir"
    done
}

process_nonroot_applet() {
    subapplet_directory="$1"
    if [ -d "$subapplet_directory/menu_applet" ]; then
        validate_menu_source "$subapplet_directory"
        install_menu_into_directory "$subapplet_directory/menu_applet/index.ts" "$subapplet_directory/menu"
        distribute_menu_to_subpages "$subapplet_directory" "$subapplet_directory/menu_applet/index.ts"
    fi
}

sync_directory_if_nonroot_applet() {
    if is_nonroot_applet_directory "$1"; then
        process_nonroot_applet "$1"
    fi
}

build_directory_menus_nonroot() {
    for target_dir in "$webapp_directory"/*; do
        sync_directory_if_nonroot_applet "$target_dir"
    done
}

validate_argument_count "$#"
github_username="$1"
github_repo_name="$2"
webapp_directory="$HOME/.config/hdconfigure/webapps/static/$github_username/$github_repo_name"

validate_webapp_directory
build_directory_menus_nonroot
