tool_name="hdconfigure_webapps_static_internal_build_directory"

check_args() {
    if [ "$#" -lt 2 ]; then
        error "error: $tool_name usage: $tool_name <github_username> <github_repo_name>
"
        exit 1
    fi
}

check_webapp_dir() {
    if [ ! -d "$webapp_directory" ]; then
        error "error: $tool_name webapp directory $webapp_directory does not exist.
"
        exit 1
    fi
}

handle_root_home() {
    [ -d "$webapp_directory/home" ] && [ -f "$webapp_directory/home/index.ts" ] || return
    mkdir -p "$webapp_directory/home/menu" || { error "error: $tool_name failed to create menu.
"; exit 1; }
    cp "$webapp_directory/menu_applet/index.ts" "$webapp_directory/home/menu/index.ts" || { error "error: $tool_name failed to copy.
"; exit 1; }
}

process_root_applet_item() {
    [ "$(basename "$1")" = "menu_applet" ] || [ "$(basename "$1")" = "home" ] && return
    [ -f "$1/home_applet" ] && [ -f "$1/index.ts" ] || return
    mkdir -p "$1/menu" || { error "error: $tool_name failed to create menu.
"; exit 1; }
    cp "$webapp_directory/menu_applet/index.ts" "$1/menu/index.ts" || { error "error: $tool_name failed to copy.
"; exit 1; }
}

handle_root_other_applets() {
    for applet_path in "$webapp_directory"/*; do
        [ -d "$applet_path" ] && process_root_applet_item "$applet_path"
    done
}

handle_root_level_applets() {
    [ -d "$webapp_directory/menu_applet" ] && [ -f "$webapp_directory/menu_applet/index.ts" ] || return
    handle_root_home
    handle_root_other_applets
}

process_subapplet_self() {
    [ -f "$1/index.ts" ] || return
    mkdir -p "$1/menu" || { error "error: $tool_name failed to create menu.
"; exit 1; }
    cp "$2" "$1/menu/index.ts" || { error "error: $tool_name failed to copy.
"; exit 1; }
}

process_subfolder_item() {
    [ "$(basename "$1")" = "menu_applet" ] || [ "$(basename "$1")" = "menu" ] && return
    [ -f "$1/index.ts" ] || return
    mkdir -p "$1/menu" || { error "error: $tool_name failed to create menu.
"; exit 1; }
    cp "$2" "$1/menu/index.ts" || { error "error: $tool_name failed to copy.
"; exit 1; }
}

process_all_subfolders() {
    for sub_path in "$1"/*; do
        [ -d "$sub_path" ] && process_subfolder_item "$sub_path" "$2"
    done
}

process_regular_applet_item() {
    [ "$(basename "$1")" = "menu_applet" ] || [ "$(basename "$1")" = "home" ] && return
    [ -f "$1/home_applet" ] || [ ! -f "$1/menu_applet/index.ts" ] && return
    process_subapplet_self "$1" "$1/menu_applet/index.ts"
    process_all_subfolders "$1" "$1/menu_applet/index.ts"
}

handle_regular_subapplets() {
    for applet_path in "$webapp_directory"/*; do
        [ -d "$applet_path" ] && process_regular_applet_item "$applet_path"
    done
}

check_args "$@"
github_username="$1"
github_repo_name="$2"
webapp_directory="$HOME/.config/hdconfigure/webapps/static/$github_username/$github_repo_name"
check_webapp_dir

handle_root_level_applets
handle_regular_subapplets
