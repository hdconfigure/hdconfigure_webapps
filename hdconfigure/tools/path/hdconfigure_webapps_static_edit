tool_name="hdconfigure_webapps_static_edit"

check_args() {
    if [ "$#" -lt 4 ]; then
        error "error: $tool_name usage: $tool_name <github_username> <github_repo_name> <applet_name> <applet_page>
"
        exit 1
    fi
}

check_webapp_dir() {
    if [ ! -d "$webapp_directory" ]; then
        error "error: $tool_name webapp directory $webapp_directory does not exist.
"
        exit 1
    fi
}

get_home_path() {
    if [ "$applet_page" = "home" ]; then
        echo "$webapp_directory/home/index.ts"
    else
        echo "$webapp_directory/$applet_page/index.ts"
    fi
}

get_sub_path() {
    if [ "$applet_page" = "home" ]; then
        echo "$webapp_directory/$applet_name/index.ts"
    else
        echo "$webapp_directory/$applet_name/$applet_page/index.ts"
    fi
}

get_target_path() {
    if [ "$applet_name" = "home" ]; then
        get_home_path
    else
        get_sub_path
    fi
}

open_file() {
    if [ -f "$1" ]; then
        nano "$1"
    else
        error "error: $tool_name index.ts does not exist at $1
"
        exit 1
    fi
}

check_args "$@"
github_username="$1"
github_repo_name="$2"
applet_name="$3"
applet_page="$4"
webapp_directory="$HOME/.config/hdconfigure/webapps/static/$github_username/$github_repo_name"
check_webapp_dir
target_file=$(get_target_path)
open_file "$target_file"
